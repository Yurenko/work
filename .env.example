# =========================
# MODE: PAPER | LIVE
# =========================
MODE=PAPER

# =========================
# HEDGE STRATEGY
# =========================
ENTRY_SUM_MAX=0.80
EXIT_SUM_MIN=1.10
PM_SHARES=6
BASE_SHARES=6
SHARES_STEP=6
MAX_SHARES=20
MAX_RECOVERY_DEBT_USD=50
BN_MIN_USD=1.0
MAX_OPEN_HEDGES=2
MIN_TIME_TO_EXPIRY_SEC=60
LEG_RETRY_SEC=3
LEG_RETRY_MAX=5

# =========================
# PREDICT.FUN (replaces Binance Prediction)
# =========================
# Get API key: https://developers.predict.fun  (or Predict Discord)
PREDICT_API_KEY=
# Hex private key for JWT + EIP-712 order signing (EOA)
PREDICT_PRIVATE_KEY=
PREDICT_REST_BASE_URL=https://api.predict.fun
PREDICT_WSS_URL=wss://ws.predict.fun/ws
PREDICT_CHAIN_ID=56
PREDICT_MIN_REQUEST_INTERVAL_MS=250

# =========================
# POLYMARKET
# =========================
# LIVE only. Never commit the private key.
PRIVATE_KEY=
FUNDER_ADDRESS=
# 0=EOA, 1=email, 2=browser wallet, 3=Polymarket deposit wallet
SIGNATURE_TYPE=0

# =========================
# DASHBOARD / SERVER
# =========================
HOST=0.0.0.0
PORT=8888
LOG_LEVEL=INFO
