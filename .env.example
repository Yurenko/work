# =========================
# MODE: PAPER | LIVE
# =========================
MODE=PAPER

# =========================
# HEDGE STRATEGY
# =========================
ENTRY_SUM_MAX=0.80
EXIT_SUM_MIN=1.10
PM_SHARES=6
BASE_SHARES=6
SHARES_STEP=6
MAX_SHARES=20
MAX_RECOVERY_DEBT_USD=50
# After a confirmed combined loss, next size = previous size × multiplier.
# The side is locked to the previous BTC candle until the next combined win.
MARTINGALE_MULTIPLIER=2
HEDGING_BASE_MODE=true
HEDGING_RECOVERY_MODE=false
# Last Chainlink print must be this close to the window end to colour the candle.
BTC_LAST_MAX_AGE_SEC=20
BN_MIN_USD=1.0
MAX_OPEN_HEDGES=2
MIN_TIME_TO_EXPIRY_SEC=60
LEG_RETRY_SEC=3
LEG_RETRY_MAX=5

# Same outcome on both venues near $0.70, same share count.
# Opposite side is bought later, per venue, only if net stays >= $0.10/share.
LOCKIN_ENABLED=true
LOCK_ENTRY_PRICE=0.70
LOCK_ENTRY_LOW=0.58
LOCK_ENTRY_HIGH=0.82
LOCK_MIN_NET_PER_SHARE=0.10
PF_TAKER_FEE_BPS=200
MAX_TOTAL_INVESTMENT_USD=50

# Used only when LOCKIN_ENABLED=false (old opposite-sum entry).
PF_EXTRA_SHARES=4
PF_TRIM_OFFSET=0.10

# =========================
# PREDICT.FUN (replaces Binance Prediction)
# =========================
# Get API key: https://developers.predict.fun  (or Predict Discord)
PREDICT_API_KEY=
# Hex private key for JWT + EIP-712 order signing (EOA)
PREDICT_PRIVATE_KEY=
# Deposit / smart-wallet address from predict.fun Settings (NOT the Privy EOA)
PREDICT_ACCOUNT=
PREDICT_REST_BASE_URL=https://api.predict.fun
PREDICT_WSS_URL=wss://ws.predict.fun/ws
PREDICT_CHAIN_ID=56
PREDICT_MIN_REQUEST_INTERVAL_MS=250

# =========================
# POLYMARKET
# =========================
# LIVE only. Never commit the private key.
PRIVATE_KEY=
FUNDER_ADDRESS=
# 0=EOA, 1=email, 2=browser wallet, 3=Polymarket deposit wallet
SIGNATURE_TYPE=0

# =========================
# DASHBOARD / SERVER
# =========================
HOST=0.0.0.0
PORT=8888
LOG_LEVEL=INFO

# Polymarket taker fee on top of CLOB makingAmount (0.04 = 4%)
PM_TAKER_FEE_RATE=0.04
